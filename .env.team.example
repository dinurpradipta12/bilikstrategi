# Isi dengan kredensial dari satu proyek Supabase BARU khusus tim ini.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PROJECT_ANON_OR_PUBLISHABLE_KEY

# Rahasia server. Jangan pernah awali nama variabel ini dengan NEXT_PUBLIC_ atau commit nilainya.
SUPABASE_SERVICE_ROLE_KEY=YOUR_PROJECT_SERVICE_ROLE_KEY

# Kode acak unik minimal 24 karakter untuk membuat Owner pertama di /setup.
TEAM_SETUP_TOKEN=REPLACE_WITH_A_LONG_RANDOM_UNIQUE_TOKEN
